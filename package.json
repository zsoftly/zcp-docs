{
  "name": "zcp-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "fmt": "prettier --write \"**/*.{js,mjs,ts,tsx,astro,md,mdx,json,yml,yaml}\"",
    "fmt:check": "prettier --check \"**/*.{js,mjs,ts,tsx,astro,md,mdx,json,yml,yaml}\"",
    "lint": "eslint src",
    "test:ai-readable": "node --test src/integrations/ai-readable-content.test.mjs",
    "test:reported-links": "node --test src/content/docs/reported-link-regressions.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-mermaid": "^3.0.0",
    "starlight-links-validator": "^0.26.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "esbuild@>=0.17.0 <0.28.1": "0.28.1",
      "vite@>=7.0.0 <7.3.5": "7.3.5",
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "fast-uri@>=3.0.0 <3.1.7": "3.1.7",
      "postcss@<=8.5.17": "8.5.18",
      "sharp@<0.35.4": "0.35.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
