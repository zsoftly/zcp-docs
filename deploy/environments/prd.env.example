# prd environment configuration
# Copy to /etc/zcp/docs.env on the prd host and fill in values.
# NEVER commit the real .env file.

# Public hostname Caddy serves this site on (the {$SITE_DOMAIN} vhost in
# deploy/caddy/prd.Caddyfile).
SITE_DOMAIN=docs.zcp.zsoftly.ca

SITE_ROOT=/var/www/zcp-docs
RELEASES_DIR=/var/releases/zcp-docs
KEEP_RELEASES=10

PUBLIC_SITE_URL=https://docs.zcp.zsoftly.ca
