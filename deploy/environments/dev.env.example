# dev environment configuration
# Copy to /etc/zcp/docs.env on the dev host and fill in values.
# NEVER commit the real .env file.

# Public hostname Caddy serves this site on. The Caddy config for every
# environment lives in the iaas repo, not here.
SITE_DOMAIN=dev-docs.zcp.zsoftly.ca

# Absolute path the reverse proxy serves static files from. This box also
# hosts stg, so the path is suffixed per environment.
SITE_ROOT=/var/www/zcp-docs-dev

# Directory where release archives are kept
RELEASES_DIR=/var/releases/zcp-docs-dev

# Number of releases to retain before pruning
KEEP_RELEASES=5

# Astro build-time site URL (used in sitemap, canonical links, and
# starlight-links-validator). Override in CI/CD before running pnpm build
# for this environment.
PUBLIC_SITE_URL=https://dev-docs.zcp.zsoftly.ca
