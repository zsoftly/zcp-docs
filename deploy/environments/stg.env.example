# stg environment configuration
# Copy to /etc/zcp/docs.env on the stg host and fill in values.
# NEVER commit the real .env file.

# This box also hosts dev, so the path is suffixed per environment.
SITE_ROOT=/var/www/zcp-docs-stg
RELEASES_DIR=/var/releases/zcp-docs-stg
KEEP_RELEASES=5

PUBLIC_SITE_URL=https://stg-docs.zcp.zsoftly.ca
