---
// Standalone page (Starlight's own 404 route is disabled), so it loads the
// Instrument tokens directly and sets data-theme itself.
import '../styles/tokens.css';
import { websiteUrl } from '../data/site';

const links = [
  { label: 'Getting started', href: '/public-cloud/getting-started/introduction' },
  { label: 'Tutorials', href: '/tutorials' },
  { label: 'CLI', href: '/public-cloud/cli/installation' },
  { label: 'API reference', href: '/public-cloud/api/reference' },
  { label: 'Changelog', href: '/changelog' },
  { label: 'Public cloud', href: '/public-cloud/getting-started/introduction' },
  { label: 'Private cloud', href: '/private-cloud/overview' },
  { label: 'Contact support', href: 'https://zcp.zsoftly.ca/contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="The documentation page you were looking for does not exist."
    />
    <link rel="icon" href="/favicon.svg" />
    <title>Page not found | ZSoftly Docs</title>
    <script is:inline>
      // Follow the theme the visitor picked in the docs (Starlight stores it
      // under starlight-theme), falling back to the system preference.
      (function () {
        var stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch (e) {}
        var dark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ZSoftly Docs home">
        <img class="brand-logo brand-logo--light" src="/logo.svg" alt="ZSoftly Cloud Platform" />
        <img class="brand-logo brand-logo--dark" src="/logo-dark.svg" alt="" />
        <span>ZSoftly Docs</span>
      </a>
      <nav aria-label="Site navigation">
        <a href="/public-cloud/getting-started/introduction">Public cloud</a>
        <a href="/private-cloud/overview">Private cloud</a>
        <a href={websiteUrl}>ZCP website</a>
      </nav>
    </header>

    <main>
      <section class="not-found" aria-labelledby="page-title">
        <div class="content">
          <p class="eyebrow">404</p>
          <h1 id="page-title">Page not found.</h1>
          <p class="lede">
            The documentation page you were looking for does not exist or has been moved.
          </p>

          <div class="actions">
            <a class="button button-primary" href="/">Back to docs home</a>
            <a class="button button-secondary" href="/public-cloud/getting-started/introduction"
              >Start with the guide</a
            >
          </div>

          <div class="link-grid" aria-label="Popular documentation links">
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} ZSoftly Technologies Inc.</span>
      <a href={websiteUrl}>zcp.zsoftly.ca</a>
    </footer>
  </body>
</html>

<style>
  /* Plain surface in both themes: no gradient, no grid. */
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    min-width: 320px;
    background: var(--zi-surface);
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    color: var(--zi-ink);
    background: var(--zi-surface);
    font-family: var(--zi-font-sans);
    -webkit-font-smoothing: antialiased;
  }

  :global(:focus-visible) {
    outline: 2px solid var(--zi-focus);
    outline-offset: 2px;
  }

  a {
    color: inherit;
  }

  .site-header {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--zi-space-8);
    padding: var(--zi-space-2) clamp(1rem, 5vw, 4rem);
    border-bottom: 1px solid var(--zi-line);
    background: var(--zi-surface-raised);
  }

  .brand,
  .site-header nav,
  .site-footer {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: var(--zi-space-3);
    color: var(--zi-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 1.75rem;
  }

  .brand-logo--dark,
  :global(:root[data-theme='dark']) .brand-logo--light {
    display: none;
  }

  :global(:root[data-theme='dark']) .brand-logo--dark {
    display: block;
  }

  .site-header nav {
    gap: clamp(0.75rem, 2.5vw, 2rem);
    color: var(--zi-ink-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .site-header nav a,
  .site-footer a {
    text-decoration: none;
    transition: color 120ms ease;
  }

  .site-header nav a:hover,
  .site-footer a:hover {
    color: var(--zi-accent);
  }

  .not-found {
    display: grid;
    min-height: calc(100vh - 8rem);
    place-items: center;
    padding: var(--zi-space-16) var(--zi-space-4);
  }

  .content {
    width: min(100%, 52rem);
  }

  /* Telemetry label */
  .eyebrow {
    margin: 0 0 var(--zi-space-3);
    color: var(--zi-ink-faint);
    font-family: var(--zi-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
  }

  /* display-1 */
  h1 {
    margin: 0;
    color: var(--zi-ink);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .lede {
    max-width: 72ch;
    margin: var(--zi-space-4) 0 0;
    color: var(--zi-ink-muted);
    font-size: 1rem;
    line-height: 1.6875;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--zi-space-3);
    margin-top: var(--zi-space-8);
  }

  .button {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: var(--zi-radius-md);
    padding: 0 var(--zi-space-3);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }

  .button-primary {
    color: var(--zi-on-accent);
    background: var(--zi-accent);
  }

  .button-primary:hover {
    background: var(--zi-accent-hover);
  }

  .button-secondary {
    color: var(--zi-ink);
    border-color: var(--zi-line-control);
    background: var(--zi-surface);
  }

  .button-secondary:hover {
    background: var(--zi-surface-raised);
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--zi-space-4);
    margin-top: var(--zi-space-12);
  }

  .link-grid a {
    border: 1px solid var(--zi-line);
    border-radius: var(--zi-radius-lg);
    padding: var(--zi-space-4);
    color: var(--zi-ink);
    background: var(--zi-surface);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 120ms ease;
  }

  .link-grid a:hover {
    border-color: var(--zi-line-strong);
  }

  .site-footer {
    justify-content: space-between;
    gap: var(--zi-space-4);
    padding: var(--zi-space-4) clamp(1rem, 5vw, 4rem);
    border-top: 1px solid var(--zi-line);
    color: var(--zi-ink-faint);
    font-size: 0.8125rem;
  }

  @media (max-width: 700px) {
    .site-header nav a:nth-child(-n + 2) {
      display: none;
    }

    .link-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: var(--zi-space-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .link-grid a,
    .site-header nav a,
    .site-footer a {
      transition: none;
    }
  }
</style>
