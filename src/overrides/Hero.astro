---
// Compact hero: a title and one line of tagline, so the page reaches its
// content quickly. The primary actions live in the site header, and the
// principle panel renders further down the page via PrinciplePanel.astro.
---

<section class="zs-hero">
  <div class="zs-hero__copy">
    <h1 class="zs-hero__title" id="_top" data-page-title>
      {`${Astro.locals.t('zs.hero.titleLine1')} ${Astro.locals.t('zs.hero.titleLine2')}`}
    </h1>
    <p class="zs-hero__tagline">{Astro.locals.t('zs.hero.tagline')}</p>
  </div>
</section>

<style>
  /* ── Hero layout ──────────────────────────────────────────── */
  .zs-hero {
    padding-block: 0.75rem 0.5rem;
  }

  .zs-hero__title {
    font-size: clamp(1.5rem, 2.5vw, 2.125rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--sl-color-text);
    margin: 0 0 0.75rem;
    border: none;
    padding: 0;
  }

  :root[data-theme='dark'] .zs-hero__title {
    color: rgba(255, 255, 255, 0.95);
  }

  .zs-hero__tagline {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  .zs-hero__tagline strong {
    color: var(--sl-color-text);
    font-weight: 600;
  }

  :root[data-theme='dark'] .zs-hero__tagline strong {
    color: rgba(255, 255, 255, 0.9);
  }

  /* Action buttons */
</style>
