---
// Mirrors Starlight's Header: site title, the documentation nav, search,
// language, theme and one primary button to the console. Below Starlight's
// 50rem breakpoint only the title and search stay here, and the nav,
// language, theme and console move into the mobile menu (MobileMenuFooter).
// Pages with a sidebar show that menu at the foot of Starlight's sidebar.
// Splash pages, such as the home page, have no sidebar, so the header opens
// the same menu in its own popover.
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';
import type { Props } from '@astrojs/starlight/props';
import MobileMenuFooter from './MobileMenuFooter.astro';
import { CLOUD_LOGIN_URL, docsNavCurrent, docsNavLinks, localePathPrefix } from '../data/site';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const { hasSidebar, siteTitleHref } = Astro.locals.starlightRoute;
const localePrefix = localePathPrefix(Astro.locals.starlightRoute.locale);
const docsLinks = docsNavLinks.map((link) => ({
  label: Astro.locals.t(link.labelKey),
  href: `${localePrefix}${link.path}`,
  current: docsNavCurrent(link, Astro.url.pathname, localePrefix),
}));
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <a href={siteTitleHref} class="site-title sl-flex">
      <img src="/zcp-icon.svg" alt="" width="28" height="28" aria-hidden="true" />
      <span translate="no">ZSoftly Cloud Platform</span>
    </a>
  </div>
  <nav
    class="header-docs-nav sl-hidden md:sl-flex print:hidden"
    aria-label={Astro.locals.t('zs.header.docsNav')}
  >
    {
      docsLinks.map((link) => (
        <a href={link.href} aria-current={link.current}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="header-search sl-flex print:hidden">
    {shouldRenderSearch && <Search {...Astro.props} />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    {
      /* The native select carries the correct per-page URLs, including fallbacks
        for pages with no translation. The script upgrades it into a menu and
        leaves the select in place when it cannot. */
    }
    <div class="lang-menu" id="lang-menu" data-label={Astro.locals.t('zs.header.languageNav')}>
      <LanguageSelect {...Astro.props} />
    </div>
    <ThemeSelect {...Astro.props} />
    <a class="header-console" href={CLOUD_LOGIN_URL} target="_blank" rel="noopener noreferrer">
      {Astro.locals.t('zs.header.openConsole')}
    </a>
  </div>
  {
    !hasSidebar && (
      <>
        <button
          type="button"
          popovertarget="zs-splash-menu"
          class="splash-menu-button sl-flex md:sl-hidden print:hidden"
        >
          <Icon name="bars" class="open-menu" />
          <Icon name="close" class="close-menu" />
          <span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
        </button>
        <div id="zs-splash-menu" popover class="splash-menu md:sl-hidden">
          <MobileMenuFooter />
        </div>
      </>
    )
  }
</div>

<script>
  // Upgrade the native language select into a small menu. The select already
  // holds the correct target URL for this page in each locale, including the
  // fallback when a page has no translation, so the options are the source of
  // truth rather than a path built by hand. If this never runs, the select
  // stays and remains fully usable.
  const langMenu = document.getElementById('lang-menu');
  const langSelect = langMenu?.querySelector('select');

  if (langMenu && langSelect && langSelect.options.length > 0) {
    const current = langSelect.options[langSelect.selectedIndex];

    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'lang-trigger';
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-controls', 'lang-panel');
    trigger.append(current?.textContent ?? '');
    trigger.insertAdjacentHTML(
      'beforeend',
      '<svg class="lang-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg>'
    );

    const panel = document.createElement('nav');
    panel.id = 'lang-panel';
    panel.className = 'lang-panel';
    panel.setAttribute('aria-label', langMenu.dataset.label ?? 'Language');

    for (const option of Array.from(langSelect.options)) {
      const item = document.createElement('a');
      item.className = 'lang-item';
      item.href = option.value;
      item.textContent = option.textContent;
      if (option === current) item.setAttribute('aria-current', 'true');
      panel.append(item);
    }

    const dropdown = document.createElement('div');
    dropdown.className = 'lang-dropdown';
    dropdown.append(panel);

    langMenu.append(trigger, dropdown);
    langMenu.setAttribute('data-enhanced', '');

    // Hover and focus open the menu in CSS. This keeps aria-expanded honest and
    // closes the menu on Escape. The menu stays open under :focus-within, so
    // data-dismissed overrides it until the pointer or focus leaves.
    const sync = () => {
      const open =
        !langMenu.hasAttribute('data-dismissed') &&
        (langMenu.matches(':hover') || langMenu.contains(document.activeElement));
      trigger.setAttribute('aria-expanded', String(open));
    };

    const release = () => {
      langMenu.removeAttribute('data-dismissed');
      sync();
    };

    for (const event of ['mouseenter', 'mouseleave', 'focusin', 'focusout'] as const) {
      langMenu.addEventListener(event, () => window.setTimeout(sync, 0));
    }

    langMenu.addEventListener('mouseenter', release);
    langMenu.addEventListener('mouseleave', release);
    langMenu.addEventListener('pointerdown', release);
    langMenu.addEventListener('focusout', (event) => {
      if (!langMenu.contains(event.relatedTarget as Node | null)) release();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const focused = langMenu.contains(document.activeElement);
      if (!focused && !langMenu.matches(':hover')) return;
      langMenu.setAttribute('data-dismissed', '');
      if (focused) trigger.focus();
      sync();
    });
  }
</script>

<style>
  @layer starlight.core {
    .header {
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      flex-shrink: 0;
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .site-title {
      align-items: center;
      color: var(--sl-color-text-accent);
      flex-shrink: 0;
      gap: 0.625rem;
      text-decoration: none;
      white-space: nowrap;
    }

    .site-title img {
      flex-shrink: 0;
      height: 1.75rem;
      max-width: none;
      width: 1.75rem;
    }

    .site-title span {
      font-size: var(--sl-text-sm);
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .right-group {
      align-items: center;
      flex-shrink: 0;
      gap: var(--zi-space-3);
    }

    /* The nav takes the free space. Where the labels in the active language do
       not fit next to the controls, it scrolls sideways inside its own box,
       so the header keeps its height and every link stays reachable. Keyboard
       focus scrolls the focused link into view. */
    .header-docs-nav {
      align-items: center;
      flex: 1 1 auto;
      gap: var(--zi-space-1);
      min-inline-size: 0;
      overflow-x: auto;
      padding: 0.25rem;
      margin: -0.25rem;
      scrollbar-width: none;
    }

    .header-docs-nav::-webkit-scrollbar {
      display: none;
    }

    .header-docs-nav a {
      border-radius: var(--zi-radius-md);
      color: var(--zi-ink);
      font-size: var(--sl-text-sm);
      font-weight: 600;
      padding: 0.35rem 0.5rem;
      text-decoration: none;
      transition: color var(--zi-transition);
      white-space: nowrap;
    }

    .header-docs-nav a:hover,
    .header-docs-nav a[aria-current] {
      color: var(--zi-accent);
    }

    .header-docs-nav a:focus-visible {
      color: var(--zi-accent);
      outline: 2px solid var(--zi-focus);
      outline-offset: -2px;
    }

    .header-search {
      flex: 0 1 14rem;
      justify-content: flex-end;
      min-inline-size: 2.5rem;
    }

    /* Primary button: the one accent fill in the header. */
    .header-console {
      align-items: center;
      background-color: var(--zi-accent);
      border-radius: var(--zi-radius-md);
      color: var(--zi-on-accent);
      display: inline-flex;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      height: 2.25rem;
      padding-inline: 0.875rem;
      text-decoration: none;
      transition: background-color var(--zi-transition);
      white-space: nowrap;
    }

    .header-console:hover {
      background-color: var(--zi-accent-hover);
      color: var(--zi-on-accent);
    }

    .header-console:focus-visible {
      outline: 2px solid var(--zi-focus);
      outline-offset: 2px;
    }

    /* Menu for splash pages below 50rem. It matches Starlight's sidebar menu
       button and opens a full-width panel under the header. */
    .splash-menu-button {
      align-items: center;
      background-color: var(--zi-surface);
      border: 1px solid var(--zi-line-control);
      border-radius: var(--zi-radius-md);
      color: var(--zi-ink);
      cursor: pointer;
      flex-shrink: 0;
      height: var(--sl-menu-button-size, 2.5rem);
      justify-content: center;
      padding: 0.5rem;
      width: var(--sl-menu-button-size, 2.5rem);
    }

    .splash-menu-button:has(~ :popover-open) {
      background-color: var(--zi-surface-raised);
    }

    .splash-menu-button:has(~ :popover-open) :global(.open-menu),
    .splash-menu-button:not(:has(~ :popover-open)) :global(.close-menu) {
      display: none;
    }

    .splash-menu {
      --sl-sidebar-pad-x: var(--sl-nav-pad-x);
      --zs-mobile-menu-surface: var(--zi-surface-raised);
      background-color: var(--zi-surface-raised);
      border: 0;
      border-top: 1px solid var(--zi-line);
      color: var(--zi-ink);
      height: calc(100dvh - var(--sl-nav-height));
      inset: var(--sl-nav-height) 0 auto;
      margin: 0;
      max-height: none;
      max-width: none;
      overflow-y: auto;
      padding: 0 var(--sl-nav-pad-x);
      width: 100%;
    }

    .splash-menu:popover-open {
      display: flex;
      flex-direction: column;
    }

    .splash-menu :global(.mobile-menu-footer) {
      border-top: 0;
      margin-top: 0;
    }

    @media (max-width: 49.999rem) {
      .header-search {
        margin-inline-start: auto;
      }
    }

    .lang-menu {
      align-items: center;
      display: flex;
      position: relative;
    }

    /* The language trigger and panel are built by the script, so they carry no
       scoped class. These rules address them globally; the root stays scoped. */
    .lang-menu[data-enhanced] :global(starlight-lang-select) {
      display: none;
    }

    .lang-menu :global(.lang-dropdown) {
      inset-block-start: 100%;
      inset-inline-end: 0;
      opacity: 0;
      padding-block-start: 0.5rem;
      position: absolute;
      transition:
        opacity 120ms ease,
        visibility 0s linear 120ms;
      visibility: hidden;
      z-index: 20;
    }

    .lang-menu:hover :global(.lang-dropdown),
    .lang-menu:focus-within :global(.lang-dropdown) {
      opacity: 1;
      transition-delay: 0s;
      visibility: visible;
    }

    .lang-menu[data-dismissed] :global(.lang-dropdown) {
      opacity: 0;
      visibility: hidden;
    }

    .lang-menu :global(.lang-panel) {
      background: var(--zi-surface);
      border: 1px solid var(--zi-line);
      border-radius: var(--zi-radius-lg);
      box-shadow: var(--zi-shadow-pop);
      display: grid;
      gap: 0.125rem;
      min-inline-size: 9rem;
      padding: var(--zi-space-2);
    }

    .lang-menu :global(.lang-item) {
      border-radius: var(--zi-radius-md);
      color: var(--sl-color-white);
      font-size: var(--sl-text-sm);
      font-weight: 500;
      padding: 0.5rem 0.65rem;
      text-decoration: none;
      transition: background-color 120ms ease;
    }

    .lang-menu :global(.lang-item:hover),
    .lang-menu :global(.lang-item:focus-visible) {
      background: var(--zi-surface-raised);
    }

    .lang-menu :global(.lang-item[aria-current='true']) {
      color: var(--sl-color-text-accent);
      font-weight: 600;
    }

    .lang-menu :global(.lang-trigger) {
      align-items: center;
      background: transparent;
      border: 0;
      border-radius: var(--zi-radius-md);
      color: var(--sl-color-text);
      cursor: pointer;
      display: flex;
      font-family: inherit;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      gap: 0.3rem;
      padding: 0.35rem 0.5rem;
      transition: color 120ms ease;
      white-space: nowrap;
    }

    .lang-menu:hover :global(.lang-trigger),
    .lang-menu:focus-within :global(.lang-trigger) {
      color: var(--sl-color-text-accent);
    }

    .lang-menu :global(.lang-chevron) {
      block-size: 0.75rem;
      inline-size: 0.75rem;
      opacity: 0.5;
      transition:
        opacity 120ms ease,
        transform 120ms ease;
    }

    .lang-menu:hover :global(.lang-chevron),
    .lang-menu:focus-within :global(.lang-chevron) {
      opacity: 0.85;
      transform: rotate(180deg);
    }

    @media (prefers-reduced-motion: reduce) {
      .lang-menu :global(.lang-dropdown),
      .lang-menu :global(.lang-chevron),
      .lang-menu :global(.lang-item) {
        transition: none;
      }

      .lang-menu:hover :global(.lang-chevron),
      .lang-menu:focus-within :global(.lang-chevron) {
        transform: none;
      }
    }

    /* Between Starlight's 50rem breakpoint and a wide window the nav and the
       controls share the bar, so the title drops its wordmark and the search
       button shows only its icon. */
    @media (min-width: 50rem) and (max-width: 79.999rem) {
      .site-title {
        gap: 0;
      }

      .site-title span {
        display: none;
      }

      .header-search {
        flex: 0 0 auto;
      }

      /* The nav may scroll here, so fade its trailing edge to show more links
         sit past it. */
      .header-docs-nav {
        -webkit-mask-image: linear-gradient(
          to right,
          var(--zi-ink) calc(100% - 1.5rem),
          transparent
        );
        mask-image: linear-gradient(to right, var(--zi-ink) calc(100% - 1.5rem), transparent);
        mask-repeat: no-repeat;
        mask-size: 100% 100%;
      }

      .header-search :global(button[data-open-modal]) {
        justify-content: center;
        padding-inline: 0;
        width: 2.5rem;
      }

      .header-search :global(button[data-open-modal] > :not(svg)) {
        display: none !important;
      }
    }
  }
</style>
