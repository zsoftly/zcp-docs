---
import Default from '@astrojs/starlight/components/Head.astro';

const isEnglishChangelog = Astro.url.pathname.replace(/\/$/, '') === '/changelog';
const changelogRssUrl = new URL('/changelog/rss.xml', Astro.site ?? Astro.url).href;
---

<Default {...Astro.props} />

{
  isEnglishChangelog && (
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ZSoftly Cloud Platform Changelog"
      href={changelogRssUrl}
    />
  )
}

<!-- External links open in a new tab (utility, all environments) -->
<script is:inline>
  (function () {
    function openExternalLinksInNewTab() {
      document.querySelectorAll('a[href]').forEach(function (a) {
        var href = a.getAttribute('href');
        var isExternal = false;
        try {
          isExternal = new URL(href, location.href).origin !== location.origin;
        } catch (e) {
          return;
        }
        if (!isExternal) return;
        if (!a.getAttribute('target')) {
          a.setAttribute('target', '_blank');
        }
        var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
        if (!rel.includes('noopener')) rel.push('noopener');
        if (!rel.includes('noreferrer')) rel.push('noreferrer');
        a.setAttribute('rel', rel.join(' '));
      });
    }
    document.addEventListener('DOMContentLoaded', openExternalLinksInNewTab);
    document.addEventListener('astro:page-load', openExternalLinksInNewTab);
  })();
</script>
