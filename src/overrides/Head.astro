---
import Default from '@astrojs/starlight/components/Head.astro';

const changelogPath = Astro.url.pathname.replace(/\/$/, '');
const isChangelog = changelogPath === '/changelog' || changelogPath === '/fr/changelog';
const changelogRssUrl = new URL('/changelog/rss.xml', Astro.site ?? Astro.url).href;
---

<Default {...Astro.props} />

<!-- Per-host runtime config: sets window.__ZCP_ENV. Served by the reverse proxy, not built in. -->
<script is:inline src="/config.js"></script>

<!-- Optional analytics and advertising scripts start only after visitor consent. -->
<script is:inline>
  (function (w, d) {
    var e = w.__ZCP_ENV || {};
    var consentKey = 'zsoftly-optional-consent-v2';

    function loadScript(id, src, options) {
      if (d.getElementById(id)) return;
      var s = d.createElement('script');
      s.id = id;
      s.src = src;
      if (options && options.async) s.async = true;
      d.head.appendChild(s);
    }

    function startClarity(advertisingConsent) {
      if (!e.clarityProjectId) return;
      w.clarity =
        w.clarity ||
        function () {
          (w.clarity.q = w.clarity.q || []).push(arguments);
        };
      w.clarity('consentv2', {
        ad_Storage: advertisingConsent ? 'granted' : 'denied',
        analytics_Storage: 'granted',
      });
      if (w.__zsoftlyClarityLoaded) return;
      w.__zsoftlyClarityLoaded = true;
      loadScript(
        'zsoftly-clarity-script',
        'https://www.clarity.ms/tag/' + encodeURIComponent(e.clarityProjectId),
        { async: true }
      );
    }

    // Reddit advertising consent is a state machine, not a load/unload toggle.
    // pixel.js cannot be unloaded once it has executed, and removing the script
    // tag leaves window.rdt and any prior initialization in place:
    //   unknown -> granted: load the pixel, initialize once, send one PageVisit
    //   granted -> denied:  make rdt inert and drop the first-party pixel cookie
    //   denied  -> granted: this page view was already counted, so do not
    //                       initialize or send PageVisit a second time
    var redditConsent = 'unknown';

    function startRedditPixel() {
      if (!e.redditPixelId || redditConsent === 'granted') return;
      redditConsent = 'granted';
      if (!w.rdt) {
        var p = (w.rdt = function () {
          p.sendEvent ? p.sendEvent.apply(p, arguments) : p.callQueue.push(arguments);
        });
        p.callQueue = [];
        loadScript('zsoftly-reddit-pixel-script', 'https://www.redditstatic.com/ads/pixel.js', {
          async: true,
        });
      }
      if (w.__zsoftlyRedditPixelInitialized) return;
      w.__zsoftlyRedditPixelInitialized = true;
      w.rdt('init', e.redditPixelId);
      w.rdt('track', 'PageVisit');
    }

    function removeScript(id) {
      var script = d.getElementById(id);
      if (script) script.remove();
    }

    function stopClarity() {
      if (w.clarity) {
        w.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
        w.clarity('consent', false);
      }
      removeScript('zsoftly-clarity-script');
      w.__zsoftlyClarityLoaded = false;
    }

    function clearRedditCookies() {
      var parts = w.location.hostname.split('.');
      var scopes = [''];
      for (var i = 0; i < parts.length - 1; i++) {
        scopes.push('; domain=.' + parts.slice(i).join('.'));
      }
      scopes.forEach(function (scope) {
        d.cookie = '_rdt_uuid=; Max-Age=0; path=/' + scope;
      });
    }

    function stopRedditPixel() {
      removeScript('zsoftly-reddit-pixel-script');
      if (redditConsent === 'granted') {
        // The tag is gone but pixel.js is still resident, so make rdt inert.
        w.rdt = function () {};
      }
      redditConsent = 'denied';
      clearRedditCookies();
    }

    w.__zsoftlyApplyConsent = function (consent) {
      var analyticsConsent = consent && consent.analytics === true;
      var advertisingConsent = consent && consent.advertising === true;

      if (analyticsConsent) startClarity(advertisingConsent);
      else stopClarity();

      if (advertisingConsent) startRedditPixel();
      else stopRedditPixel();
    };

    w.__zsoftlyWithdrawOptionalTracking = function () {
      w.__zsoftlyApplyConsent({ analytics: false, advertising: false });
    };

    try {
      var storedConsent = w.localStorage.getItem(consentKey);
      if (!storedConsent) {
        var legacyConsent = w.localStorage.getItem('zsoftly-optional-consent-v1');
        if (legacyConsent === 'granted' || legacyConsent === 'denied') {
          storedConsent = JSON.stringify({
            analytics: legacyConsent === 'granted',
            advertising: legacyConsent === 'granted',
          });
        }
      }
      if (storedConsent) {
        w.__zsoftlyApplyConsent(JSON.parse(storedConsent));
      }
    } catch (_) {
      // Do not start optional tracking when the visitor's consent state is unavailable.
    }
  })(window, document);
</script>

{
  isChangelog && (
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ZSoftly Cloud Platform Changelog"
      href={changelogRssUrl}
    />
  )
}

<!-- External links open in a new tab (utility, all environments) -->
<script is:inline>
  (function () {
    function openExternalLinksInNewTab() {
      document.querySelectorAll('a[href]').forEach(function (a) {
        var href = a.getAttribute('href');
        var isExternal = false;
        try {
          isExternal = new URL(href, location.href).origin !== location.origin;
        } catch (e) {
          return;
        }
        if (!isExternal) return;
        if (!a.getAttribute('target')) {
          a.setAttribute('target', '_blank');
        }
        var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
        if (!rel.includes('noopener')) rel.push('noopener');
        if (!rel.includes('noreferrer')) rel.push('noreferrer');
        a.setAttribute('rel', rel.join(' '));
      });
    }
    document.addEventListener('DOMContentLoaded', openExternalLinksInNewTab);
    document.addEventListener('astro:page-load', openExternalLinksInNewTab);
  })();
</script>
