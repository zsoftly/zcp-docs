---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { CLOUD_LOGIN_URL, docsNavCurrent, docsNavLinks, localePathPrefix } from '../data/site';

// Below Starlight's 50rem breakpoint the header shows only the title and
// search, so the documentation nav, language, theme and console live here.
const localePrefix = localePathPrefix(Astro.locals.starlightRoute.locale);
const docsLinks = docsNavLinks.map((link) => ({
  label: Astro.locals.t(link.labelKey),
  href: `${localePrefix}${link.path}`,
  current: docsNavCurrent(link, Astro.url.pathname, localePrefix),
}));
---

<div class="mobile-menu-footer">
  <nav class="mobile-docs-nav" aria-label={Astro.locals.t('zs.header.docsNav')}>
    {
      docsLinks.map((link) => (
        <a class="mobile-docs-link" href={link.href} aria-current={link.current}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="mobile-preferences sl-flex">
    <div class="mobile-utility-controls">
      <LanguageSelect />
      <ThemeSelect />
    </div>
  </div>

  <a class="mobile-console" href={CLOUD_LOGIN_URL} target="_blank" rel="noopener noreferrer">
    {Astro.locals.t('zs.header.openConsole')}
  </a>
</div>

<style>
  @layer starlight.core {
    .mobile-menu-footer {
      /* Semantic roles for this menu, read from the Instrument tokens, which
         already switch between Paper and Carbon. Chips are secondary
         controls: surface fill with a line-control border. */
      --zs-menu-divider: var(--zi-line);
      --zs-menu-chip-bg: var(--zi-surface);
      --zs-menu-chip-border: var(--zi-line-control);
      --zs-menu-on-accent: var(--zi-on-accent);
      /* One height for every row and control in this menu, a 44px touch target. */
      --zs-menu-control-height: 2.75rem;

      display: grid;
      gap: 0.75rem;
      margin-inline: calc(-1 * var(--sl-sidebar-pad-x));
      margin-top: auto;
      padding: 0.75rem var(--sl-sidebar-pad-x) max(0.75rem, env(safe-area-inset-bottom));
      border-top: 1px solid var(--zs-menu-divider);
      background-color: var(--zs-mobile-menu-surface, var(--sl-color-bg-sidebar));
      z-index: 1;
    }

    .mobile-docs-nav {
      display: grid;
      gap: 2px;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--zs-menu-divider);
    }

    .mobile-preferences {
      align-items: center;
      justify-content: flex-start;
    }

    .mobile-utility-controls {
      align-items: center;
      display: flex;
      gap: 0.5rem;
      min-width: 0;
    }
    .mobile-preferences,
    .mobile-utility-controls {
      width: 100%;
    }

    .mobile-utility-controls :global(starlight-theme-toggle),
    .mobile-utility-controls :global(starlight-lang-select) {
      display: block;
      flex: 0 0 auto;
      line-height: 0;
    }
    .mobile-utility-controls :global(starlight-lang-select) {
      flex: 1 1 auto;
    }

    /* The theme toggle gets the same chip treatment, but outside this layer.
       See the unlayered block below. */
    .mobile-utility-controls :global(starlight-lang-select label) {
      align-items: center;
      background-color: var(--zs-menu-chip-bg);
      border: 1px solid var(--zs-menu-chip-border);
      border-radius: var(--zi-radius-md);
      color: var(--sl-color-text);
      display: flex;
      height: var(--zs-menu-control-height);
      min-height: var(--zs-menu-control-height);
      overflow: hidden;
      position: relative;
    }

    .mobile-utility-controls :global(starlight-lang-select label:hover),
    .mobile-utility-controls :global(starlight-lang-select label:focus-within) {
      background-color: var(--zi-surface-raised);
      color: var(--zi-ink);
    }

    .mobile-utility-controls :global(starlight-theme-toggle .theme-icon) {
      flex-shrink: 0;
    }

    .mobile-utility-controls :global(starlight-lang-select label) {
      --sl-inline-padding: 0.75rem;
      min-width: 7.25rem;
      width: 100%;
    }

    .mobile-utility-controls :global(starlight-lang-select select) {
      height: 100%;
      margin: 0;
      padding-block: 0;
    }

    .mobile-utility-controls :global(option) {
      background-color: var(--zi-surface);
      color: var(--zi-ink);
    }
  }

  /* Unlayered on purpose. Normal declarations outside a cascade layer beat
     every layered rule regardless of specificity, which is what these rules need
     against Starlight's own layered defaults. Do not move them back into
     starlight.core, and do not reach for !important instead. */
  /* The nav chips and the console button are links, and inside Starlight's
     sidebar the generic .sidebar a rules in custom.css would restyle them, so
     these selectors also outrank those. */
  /* Nav rows follow the Instrument SidebarNav: plain full-width rows, no box. */
  .mobile-menu-footer a.mobile-docs-link {
    align-items: center;
    background-color: transparent;
    border: 0;
    border-inline-start: 2px solid transparent;
    border-radius: var(--zi-radius-md);
    color: var(--zi-ink);
    display: flex;
    font-size: 0.9375rem;
    font-weight: 600;
    min-height: var(--zs-menu-control-height);
    padding: 0 0.75rem;
    text-decoration: none;
    transition:
      background-color var(--zi-transition),
      border-color var(--zi-transition);
  }

  .mobile-menu-footer a.mobile-docs-link:hover,
  .mobile-menu-footer a.mobile-docs-link:focus-visible {
    background-color: var(--zi-surface-raised);
    color: var(--zi-ink);
  }

  .mobile-menu-footer a.mobile-docs-link[aria-current] {
    background-color: var(--zi-accent-soft);
    border-inline-start-color: var(--zi-accent);
    border-radius: 0 var(--zi-radius-md) var(--zi-radius-md) 0;
    color: var(--zi-accent);
  }

  .mobile-menu-footer a.mobile-console {
    align-items: center;
    background-color: var(--zi-accent);
    border: 0;
    border-radius: var(--zi-radius-md);
    color: var(--zs-menu-on-accent);
    display: flex;
    font-size: 0.875rem;
    font-weight: 600;
    justify-content: center;
    min-height: 3rem;
    padding: 0 1rem;
    text-decoration: none;
    transition: background-color var(--zi-transition);
  }

  .mobile-menu-footer a.mobile-console:hover,
  .mobile-menu-footer a.mobile-console:focus-visible {
    background-color: var(--zi-accent-hover);
    color: var(--zs-menu-on-accent);
  }

  .mobile-menu-footer .mobile-utility-controls :global(starlight-theme-toggle .theme-toggle-btn) {
    align-items: center;
    background-color: var(--zs-menu-chip-bg);
    border: 1px solid var(--zs-menu-chip-border);
    border-radius: var(--zi-radius-md);
    color: var(--sl-color-text);
    display: flex;
    height: var(--zs-menu-control-height);
    justify-content: center;
    min-height: var(--zs-menu-control-height);
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 2.5rem;
  }

  .mobile-menu-footer
    .mobile-utility-controls
    :global(starlight-theme-toggle .theme-toggle-btn:hover),
  .mobile-menu-footer
    .mobile-utility-controls
    :global(starlight-theme-toggle .theme-toggle-btn:focus-visible) {
    background-color: var(--zi-surface-raised);
    color: var(--zi-ink);
  }
</style>
