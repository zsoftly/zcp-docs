---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { CLOUD_LOGIN_URL, CLOUD_REGISTER_URL } from '../data/site';
---

<div class="mobile-menu-footer">
  <div
    class="mobile-auth-actions"
    role="group"
    aria-label={Astro.locals.t('zs.header.accountActions')}
  >
    <a
      class="mobile-auth-link mobile-auth-login"
      href={CLOUD_LOGIN_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      {Astro.locals.t('zs.header.login')}
    </a>
    <a
      class="mobile-auth-link mobile-auth-signup"
      href={CLOUD_REGISTER_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      {Astro.locals.t('zs.header.signup')}
    </a>
  </div>

  <div class="mobile-preferences sl-flex">
    <div class="social-icons">
      <SocialIcons />
    </div>
    <div class="mobile-utility-controls">
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  @layer starlight.core {
    .mobile-menu-footer {
      /* Light and dark values for the same semantic colour. Everything below
         reads these, so a theme swap is one block rather than one rule per
         element. rgb(0 25 138) and rgb(107 142 245) are --sl-color-accent in
         light and dark; they are spelled out here because CSS cannot apply
         alpha to a hex custom property. */
      --zs-menu-divider: rgba(0, 25, 138, 0.18);
      --zs-menu-chip-bg: rgba(255, 255, 255, 0.88);
      --zs-menu-chip-border: rgba(0, 25, 138, 0.18);
      --zs-menu-social-bg: rgba(255, 255, 255, 0.78);
      --zs-menu-social-border: rgba(0, 25, 138, 0.14);
      --zs-menu-on-accent: #ffffff;

      margin-inline: calc(-1 * var(--sl-sidebar-pad-x));
      margin-top: auto;
      padding: 0.75rem var(--sl-sidebar-pad-x) max(0.75rem, env(safe-area-inset-bottom));
      border-top: 1px solid var(--zs-menu-divider);
      background-color: var(--zs-mobile-menu-surface, var(--sl-color-bg-sidebar));
      z-index: 1;
    }

    :global(:root[data-theme='dark']) .mobile-menu-footer {
      --zs-menu-divider: rgba(107, 142, 245, 0.22);
      --zs-menu-chip-bg: rgba(6, 10, 26, 0.86);
      --zs-menu-chip-border: rgba(107, 142, 245, 0.26);
      --zs-menu-social-bg: rgba(6, 10, 26, 0.86);
      --zs-menu-social-border: rgba(107, 142, 245, 0.26);
    }

    .mobile-auth-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.75rem;
    }

    .mobile-auth-link {
      align-items: center;
      border-radius: 0.375rem;
      display: flex;
      font-size: 0.875rem;
      font-weight: 700;
      justify-content: center;
      min-height: 3rem;
      padding-inline: 1rem;
      text-decoration: none;
      transition:
        background-color 150ms ease,
        border-color 150ms ease,
        color 150ms ease;
    }

    .mobile-auth-login {
      border: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-text);
    }

    .mobile-auth-login:hover,
    .mobile-auth-login:focus-visible {
      background-color: var(--sl-color-gray-6);
      color: var(--sl-color-text);
      text-decoration: none;
    }

    .mobile-auth-signup {
      background-color: var(--sl-color-accent);
    }

    .mobile-auth-signup:hover,
    .mobile-auth-signup:focus-visible {
      background-color: var(--sl-color-accent-high);
      text-decoration: none;
    }

    .social-icons {
      align-items: center;
      display: flex;
      gap: 1rem;
      margin-inline-end: auto;
      padding-block: 0;
    }

    .social-icons :global(a) {
      align-items: center;
      background-color: var(--zs-menu-social-bg);
      border: 1px solid var(--zs-menu-social-border);
      border-radius: 999px;
      color: var(--sl-color-accent);
      display: flex;
      height: 2.5rem;
      justify-content: center;
      margin: 0;
      width: 2.5rem;
    }

    .social-icons:empty {
      display: none;
    }

    .mobile-preferences {
      align-items: center;
      column-gap: 1rem;
      flex-wrap: nowrap;
      justify-content: space-between;
      padding-top: 0.75rem;
    }

    .mobile-utility-controls {
      align-items: center;
      display: flex;
      gap: 0.5rem;
      margin-inline-start: auto;
      min-width: 0;
    }

    .mobile-utility-controls :global(starlight-theme-toggle),
    .mobile-utility-controls :global(starlight-lang-select) {
      display: block;
      flex: 0 0 auto;
      line-height: 0;
    }

    /* The theme toggle gets the same chip treatment, but outside this layer.
       See the unlayered block below. */
    .mobile-utility-controls :global(starlight-lang-select label) {
      align-items: center;
      background-color: var(--zs-menu-chip-bg);
      border: 1px solid var(--zs-menu-chip-border);
      border-radius: 999px;
      color: var(--sl-color-text);
      display: flex;
      height: 2.5rem;
      min-height: 2.5rem;
      overflow: hidden;
      position: relative;
    }

    .social-icons :global(a:hover),
    .social-icons :global(a:focus-visible),
    .mobile-utility-controls :global(starlight-lang-select label:hover),
    .mobile-utility-controls :global(starlight-lang-select label:focus-within) {
      background-color: var(--sl-color-accent);
      border-color: var(--sl-color-accent);
      color: var(--zs-menu-on-accent);
    }

    .mobile-utility-controls :global(starlight-theme-toggle .theme-icon) {
      flex-shrink: 0;
    }

    .mobile-utility-controls :global(starlight-lang-select label) {
      --sl-inline-padding: 0.5rem;
      min-width: 7.25rem;
    }

    .mobile-utility-controls :global(starlight-lang-select select) {
      height: 100%;
      margin: 0;
      padding-block: 0;
    }

    .mobile-utility-controls :global(option) {
      background-color: var(--sl-color-accent);
      color: var(--zs-menu-on-accent);
    }
  }

  /* Unlayered on purpose. Normal declarations outside a cascade layer beat
     every layered rule regardless of specificity, which is what these two need
     against Starlight's own layered defaults. Do not move them back into
     starlight.core, and do not reach for !important instead. */
  .mobile-menu-footer .mobile-auth-signup,
  .mobile-menu-footer .mobile-auth-signup:hover,
  .mobile-menu-footer .mobile-auth-signup:focus-visible {
    color: var(--zs-menu-on-accent);
  }

  .mobile-menu-footer .mobile-utility-controls :global(starlight-theme-toggle .theme-toggle-btn) {
    align-items: center;
    background-color: var(--zs-menu-chip-bg);
    border: 1px solid var(--zs-menu-chip-border);
    border-radius: 999px;
    color: var(--sl-color-text);
    display: flex;
    height: 2.5rem;
    justify-content: center;
    min-height: 2.5rem;
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 2.5rem;
  }

  .mobile-menu-footer
    .mobile-utility-controls
    :global(starlight-theme-toggle .theme-toggle-btn:hover),
  .mobile-menu-footer
    .mobile-utility-controls
    :global(starlight-theme-toggle .theme-toggle-btn:focus-visible) {
    background-color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--zs-menu-on-accent);
  }
</style>
