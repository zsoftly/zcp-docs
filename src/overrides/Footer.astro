---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Footer.astro';
import { websiteUrl } from '../data/site';

const localePrefix = Astro.locals.starlightRoute.locale === 'fr' ? '/fr' : '';
const buildDate = new Date().toISOString().slice(0, 10);
---

<Default {...Astro.props} />

<div class="site-footer">
  <div class="site-footer__inner">
    <nav class="site-footer__nav" aria-label={Astro.locals.t('zs.footer.navLabel')}>
      <a href={`${localePrefix}/public-cloud/getting-started/introduction`}>ZCP</a>
      <a href={`${localePrefix}/private-cloud/overview`}>ZPCP</a>
      <a href={`${localePrefix}/public-cloud/cli/installation`}>CLI</a>
      <a href={`${localePrefix}/public-cloud/api/authentication`}>API</a>
      <a href={websiteUrl} target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.website')}</a
      >
      <a href={`${websiteUrl}/services`} target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.services')}</a
      >
      <a href={`${websiteUrl}/compare`} target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.compare')}</a
      >
      <a href={`${websiteUrl}/services/private-cloud`} target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.privateCloud')}</a
      >
      <a href={`${websiteUrl}/pricing`} target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.pricing')}</a
      >
      <a href={`${websiteUrl}/pricing#calculator`} target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.pricingCalculator')}</a
      >
      <a href={`${websiteUrl}/contact`} target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.contact')}</a
      >
      <a href="https://cloud.zcp.zsoftly.ca" target="_blank" rel="noopener noreferrer"
        >{Astro.locals.t('zs.footer.console')}</a
      >
      <a
        href="https://status.zcp.zsoftly.ca/status-page/e6c6cd2d-5290-4091-a150-2d046be03d75"
        target="_blank"
        rel="noopener noreferrer">{Astro.locals.t('zs.footer.status')}</a
      >
      <a href="https://github.com/zsoftly/zcp-docs" target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >
    </nav>
    <p class="site-footer__copy">
      © {new Date().getFullYear()} ZSoftly Technologies Inc.
      <span class="site-footer__version">{Astro.locals.t('zs.footer.build')} {buildDate}</span>
    </p>
    <a
      data-status-badge-link
      hidden
      class="site-footer__status"
      href="https://status.zcp.zsoftly.ca/status-page/e6c6cd2d-5290-4091-a150-2d046be03d75"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img data-status-badge alt="ZCP system status" height="20" />
    </a>
    <script is:inline>
      (function () {
        var token = (window.__ZCP_ENV || {}).statusBadgeToken;
        if (!token) return;
        var img = document.querySelector('[data-status-badge]');
        var link = document.querySelector('[data-status-badge-link]');
        if (!img || !link) return;
        img.src =
          'https://status.zcp.zsoftly.ca/api/status-page/badge/e6c6cd2d-5290-4091-a150-2d046be03d75?token=' +
          encodeURIComponent(token);
        link.hidden = false;
      })();
    </script>
  </div>
</div>

<style>
  .site-footer__version {
    margin-inline-start: 0.75rem;
    font-size: 0.7rem;
    color: var(--sl-color-gray-4);
    font-variant-numeric: tabular-nums;
  }

  .site-footer__status {
    display: inline-block;
    margin-block-start: 0.75rem;
  }
</style>
