---
import type { SidebarEntry } from '@astrojs/starlight/utils/routing/types';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

interface Props {
  sublist: SidebarEntry[];
  nested?: boolean;
  zcpDepth?: number;
}

const { sublist, nested, zcpDepth } = Astro.props;

const isFrench = Astro.locals.starlightRoute.locale === 'fr';

function toggleLabel(label: string) {
  return isFrench ? `Afficher ou masquer ${label}` : `Show or hide ${label}`;
}

function hasCurrentEntry(entries: SidebarEntry[]): boolean {
  return entries.some((entry) =>
    entry.type === 'link' ? entry.isCurrent : hasCurrentEntry(entry.entries)
  );
}

function firstLinkHref(entries: SidebarEntry[]): string | undefined {
  return entries.find((entry) => entry.type === 'link')?.href;
}

function isZcpRoot(entry: SidebarEntry): boolean {
  return entry.type === 'group' && entry.label === 'ZCP';
}

function isMarketplaceCategory(entries: SidebarEntry[]): boolean {
  const href = firstLinkHref(entries);
  return /^\/(?:fr\/)?public-cloud\/marketplace\/[^/]+\/?$/.test(href ?? '');
}
---

<ul class:list={{ 'top-level': !nested }}>
  {
    sublist.map((entry) => {
      if (entry.type === 'link') {
        return (
          <li>
            <a
              href={entry.href}
              aria-current={entry.isCurrent ? 'page' : undefined}
              class:list={[{ large: !nested }, entry.attrs.class]}
              {...entry.attrs}
            >
              <span>{entry.label}</span>
              {entry.badge && (
                <span class:list={['sl-badge', entry.badge.variant, entry.badge.class]}>
                  {entry.badge.text}
                </span>
              )}
            </a>
          </li>
        );
      }

      const isZcpCategory = zcpDepth === 0;
      const isLinkedMarketplaceCategory = zcpDepth === 1 && isMarketplaceCategory(entry.entries);
      const href =
        isZcpCategory || isLinkedMarketplaceCategory ? firstLinkHref(entry.entries) : undefined;
      const isOpen = hasCurrentEntry(entry.entries) || !entry.collapsed;
      const childZcpDepth = isZcpRoot(entry)
        ? 0
        : zcpDepth === undefined
          ? undefined
          : zcpDepth + 1;

      return (
        <li>
          <details open={isOpen} class:list={{ 'has-linked-label': Boolean(href) }}>
            {href ? (
              <>
                <summary class="group-toggle" aria-label={toggleLabel(entry.label)}>
                  <svg class="caret" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </summary>
                <a href={href} class="group-link">
                  <span class="group-label">
                    <span class="large">{entry.label}</span>
                    {entry.badge && (
                      <span class:list={['sl-badge', entry.badge.variant, entry.badge.class]}>
                        {entry.badge.text}
                      </span>
                    )}
                  </span>
                </a>
              </>
            ) : (
              <summary>
                <span class="group-label">
                  <span class="large">{entry.label}</span>
                  {entry.badge && (
                    <span class:list={['sl-badge', entry.badge.variant, entry.badge.class]}>
                      {entry.badge.text}
                    </span>
                  )}
                </span>
                <svg class="caret" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </summary>
            )}
            <SidebarRestorePoint />
            <Astro.self sublist={entry.entries} nested zcpDepth={childZcpDepth} />
          </details>
        </li>
      );
    })
  }
</ul>

<style>
  @layer starlight.core {
    ul {
      --sl-sidebar-item-padding-inline: 0.5rem;
      list-style: none;
      padding: 0;
    }

    li {
      overflow-wrap: anywhere;
    }

    ul ul li {
      margin-inline-start: var(--sl-sidebar-item-padding-inline);
      border-inline-start: 1px solid var(--sl-color-hairline-light);
      padding-inline-start: var(--sl-sidebar-item-padding-inline);
    }

    .large {
      font-size: var(--sl-text-lg);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .top-level > li + li {
      margin-top: 0.75rem;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.2em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
      cursor: pointer;
      user-select: none;
    }

    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .caret {
      transition: transform 0.2s ease-in-out;
      flex-shrink: 0;
      width: 1.25rem;
      height: 1.25rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    :global([dir='rtl']) .caret {
      transform: rotateZ(180deg);
    }

    [open] > summary .caret {
      transform: rotateZ(90deg);
    }

    a {
      display: block;
      border-radius: 0.25rem;
      text-decoration: none;
      color: var(--sl-color-gray-2);
      padding: 0.3em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
    }

    a:hover,
    a:focus {
      color: var(--sl-color-white);
    }

    [aria-current='page'],
    [aria-current='page']:hover,
    [aria-current='page']:focus {
      font-weight: 600;
      color: var(--sl-color-text-invert);
      background-color: var(--sl-color-text-accent);
    }

    a > *:not(:last-child),
    .group-label > *:not(:last-child) {
      margin-inline-end: 0.25em;
    }

    .has-linked-label {
      position: relative;
    }

    .has-linked-label > .group-link {
      padding-inline-end: 2.25rem;
    }

    .has-linked-label > .group-toggle {
      position: absolute;
      inset-inline-end: 0.25rem;
      top: 0.1rem;
      z-index: 1;
      padding: 0.3em;
    }

    .has-linked-label > .group-toggle:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: -2px;
      border-radius: 0.25rem;
    }
  }
</style>
